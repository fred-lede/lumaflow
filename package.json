{
  "name": "lumaflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest --exclude 'tests/e2e/**/*.spec.ts'",
    "test:unit": "vitest --exclude 'tests/e2e/**/*.spec.ts'",
    "test:e2e": "vitest run --environment jsdom tests/e2e",
    "test:ui": "vitest --ui",
    "fixtures": "node --experimental-strip-types scripts/generate-fixtures.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/ui": "4.1.8",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.8"
  }
}
